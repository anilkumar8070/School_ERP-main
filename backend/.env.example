# Backend Environment Configuration Template

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connectivity (Prisma PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_erp?schema=public"

# Legacy MongoDB (Optional Fallback)
MONGODB_URI="mongodb://127.0.0.1:27017/school_erp"

# Authentication & JWT Security
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES="24h"

# CORS & Domain Settings
ALLOW_ALL_ORIGINS=true
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# SMTP Email Configuration (Nodemailer)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_smtp_user"
SMTP_PASS="your_smtp_password"
FROM_EMAIL="noreply@school.com"

# SendGrid Integration (Optional)
SENDGRID_API_KEY="your_sendgrid_api_key"
SENDGRID_USE_WEB=true

# Razorpay Payment Gateway (Optional)
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Twilio SMS Service (Optional)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+15005550006"

# Payload & Storage Constraints
JSON_BODY_LIMIT="10mb"
MAX_UPLOAD_BYTES=1073741824
