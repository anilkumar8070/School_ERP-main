
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdmissionEnquiry {
  id String @id @default(uuid())
  applicantName String
  parentName String
  phone String
  email String?
  classApplying String
  enquiryDate DateTime
  status String?
  notes String?
  createdBy String?
  createdAt DateTime?
  updatedAt DateTime?
}

model AdmitCard {
  id String @id @default(uuid())
  schoolName String?
  examName String?
  className String?
  section String?
  recipientId String?
  recipientType String?
  recipientName String?
  rollNumber String?
  examRollNumber String?
  studentEmail String?
  subjects Json?
  instructions String?
  dateOfExam String?
  filePath String?
  mime String?
  issuedBy String?
  issuedAt DateTime?
  createdAt DateTime?
  updatedAt DateTime?
}

model Assignment {
  id String @id @default(uuid())
  subject String?
  filePath String?
  title String
  description String?
  class String
  section String?
  dueDate DateTime?
  createdBy String?
  createdAt DateTime?
  updatedAt DateTime?
}

model Attendance {
  id String @id @default(uuid())
  class String
  section String?
  date String
  records Json?
  createdBy String?
  createdAt DateTime?
  updatedAt DateTime?

  @@index([class, section])
  @@index([date])
}

model BehaviorRecord {
  id String @id @default(uuid())
  studentId String
  studentName String?
  class String?
  section String?
  rollNo String?
  type String
  title String
  description String?
  actionTaken String?
  followUpDate String?
  severity String?
  status String?
  recordedBy String?
  recordedByName String?
  recordDate String
  createdAt DateTime?
  updatedAt DateTime?
}

model Certificate {
  id String @id @default(uuid())
  schoolName String?
  title String?
  recipientId String?
  recipientType String?
  recipientName String?
  certificationFor String?
  dateOfIssue String?
  signaturePath String?
  filePath String?
  mime String?
  uploadedBy String?
  uploadedAt DateTime?
  createdAt DateTime?
  updatedAt DateTime?
}

model Class {
  id String @id @default(uuid())
  name String @unique
  subjects Json?
  createdAt DateTime?
  updatedAt DateTime?
}

model Complaint {
  id String @id @default(uuid())
  userId String?
  username String?
  text String
  priority String?
  status String?
  history Json?
  createdAt DateTime?
  updatedAt DateTime?
}

model ContactQuery {
  id String @id @default(uuid())
  name String
  email String
  contact String?
  description String?
  filename String?
  originalname String?
  status String?
  notified Boolean?
  notes Json?
  note String?
  createdBy String?
  createdAt DateTime?
  updatedAt DateTime?
}

model CustomForm {
  id String @id @default(uuid())
  title String
  category String?
  description String?
  status String?
  fields Json?
  createdBy String?
  createdAt DateTime?
  updatedAt DateTime?
}

model DeletionRequest {
  id String @id @default(uuid())
  studentId String?
  studentEmail String?
  studentName String?
  class String?
  section String?
  rollNo String?
  requestedBy String?
  requestedByName String?
  note String?
  status String?
  createdAt DateTime?
  updatedAt DateTime?
}

model Discount {
  id String @id @default(uuid())
  studentId String
  studentName String?
  type String
  amount Float
  amountType String?
  term String
  reason String?
  appliedBy String?
  createdAt DateTime?
  updatedAt DateTime?
}

model Event {
  id String @id @default(uuid())
  title String
  description String?
  date DateTime
  createdBy String?
  createdAt DateTime?
  updatedAt DateTime?
}

model Faculty {
  id String @id @default(uuid())
  name String
  email String? @unique
  classGrade String?
  employeeId String?
  subject String?
  experience String?
  contact String?
  avatar String?
  assignments Json?
  role String?
  houses Json?
  createdAt DateTime?
  updatedAt DateTime?

  @@index([role])
  @@index([subject])
}

model FacultyAttendance {
  id String @id @default(uuid())
  date String
  records Json?
  createdBy String?
  createdAt DateTime?
  updatedAt DateTime?
}

model FacultyRegistration {
  id String @id @default(uuid())
  name String
  email String @unique
  subject String?
  classGrade String?
  education String?
  experience String?
  contact String?
  avatar String?
  houses Json?
  status String?
  note String?
  password String?
  createdAt DateTime?
  updatedAt DateTime?
}

model FeeStructure {
  id String @id @default(uuid())
  class String
  section String?
  term1 Float?
  term2 Float?
  term1DueDate String?
  term2DueDate String?
  term1FineMode String?
  term1FineAmount Float?
  term2FineMode String?
  term2FineAmount Float?
  history Json?
  createdAt DateTime?
  updatedAt DateTime?
}

model FormQuery {
  id String @id @default(uuid())
  formId String?
  formTitle String?
  name String
  email String
  contact String?
  description String?
  formType String?
  responses Json?
  attachments Json?
  filename String?
  originalname String?
  createdBy String?
  createdAt DateTime?
  updatedAt DateTime?
}

model FrontOffice {
  id String @id @default(uuid())
  visitorName String
  purpose String?
  host String?
  checkInTime DateTime
  checkOutTime DateTime?
  status String?
  notes String?
  createdBy String?
  createdAt DateTime?
  updatedAt DateTime?
}

model Gallery {
  id String @id @default(uuid())
  label String
  images Json?
  createdBy String?
  createdAt DateTime?
  updatedAt DateTime?
}

model Hostel {
  id String @id @default(uuid())
  name String
  floors Json?
  address String?
  capacity Float?
  amenities Json?
  warden String?
  contact String?
  createdAt DateTime?
  updatedAt DateTime?
}

model HostelAllocation {
  id String @id @default(uuid())
  when Float
  hostelId String
  floorNo Float
  roomNo Float
  bedIndex Float
  bedType String
  paid Boolean?
  payments Json?
  createdAt DateTime?
  updatedAt DateTime?
}

model IDCard {
  id String @id @default(uuid())
  studentId String?
  facultyId String?
  userId String?
  type String?
  name String?
  fatherName String?
  rollNo String?
  class String?
  gender String?
  medium String?
  section String?
  contact String?
  email String?
  designation String?
  schoolName String?
  photoUrl String?
  house String?
  houseRole String?
  template String?
  batchId String?
  version Float?
  generatedBy String?
  idCode String? @unique
  issueDate DateTime?
  validUpto DateTime?
  createdAt DateTime?
  updatedAt DateTime?
}

model Leave {
  id String @id @default(uuid())
  userId String?
  username String?
  email String?
  role String?
  class String?
  section String?
  rollNo String?
  from DateTime?
  to DateTime?
  reason String?
  status String?
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?
  createdAt DateTime?
  updatedAt DateTime?
}

model LessonPlan {
  id String @id @default(uuid())
  facultyUserId String
  facultyId String?
  teacherName String?
  class String
  section String?
  subject String
  title String
  lessonDate String
  durationMinutes Float?
  objectives String?
  materials String?
  activities String?
  homework String?
  assessment String?
  status String?
  notes String?
  createdAt DateTime?
  updatedAt DateTime?
}

model Mark {
  id String @id @default(uuid())
  class String
  section String?
  studentId String?
  subject String?
  total Float?
  obtained Float?
  term String?
  createdBy String?
  createdAt DateTime?
  updatedAt DateTime?

  @@index([class, section])
  @@index([studentId])
}

model Meeting {
  id String @id @default(uuid())
  title String
  summary String?
  datetime DateTime
  link String?
  audience String?
  class String?
  section String?
  studentId String?
  createdBy String?
  createdAt DateTime?
  updatedAt DateTime?
}

model Message {
  id String @id @default(uuid())
  parentName String?
  studentName String?
  className String?
  subject String?
  description String
  priority String?
  status String?
  createdBy String?
  createdByUsername String?
  history Json?
  createdAt DateTime?
  updatedAt DateTime?
}

model Notice {
  id String @id @default(uuid())
  title String
  body String?
  targets Json?
  filePath String?
  fileName String?
  fileMime String?
  studentAll Boolean?
  studentClass String?
  studentSection String?
  createdBy String?
  createdByName String?
  createdAt DateTime?
  updatedAt DateTime?
}

model NotificationSettings {
  id String @id @default(uuid())
  event String @unique
  email Boolean?
  sms Boolean?
  whatsapp Boolean?
  createdAt DateTime?
  updatedAt DateTime?
}

model OnlineAdmission {
  id String @id @default(uuid())
  studentName String
  dob DateTime
  gender String
  address String
  parentName String
  parentPhone String
  classApplying String
  documentPath String?
  status String?
  submittedAt DateTime?
  createdAt DateTime?
  updatedAt DateTime?
}

model PasswordReset {
  id String @id @default(uuid())
  userId String
  token String @unique
  expiresAt DateTime
  createdAt DateTime?
  updatedAt DateTime?
}

model Question {
  id String @id @default(uuid())
  testId String?
  questionText String
  options Json?
  questionImage String?
  optionImages Json?
  correctAnswer String?
  explanation String?
  marks Float?
  negativeMarks Float?
  createdAt DateTime?
  updatedAt DateTime?
}

model Receipt {
  id String @id @default(uuid())
  studentId String?
  allocationId String?
  studentName String?
  studentEmail String?
  class String?
  term String?
  amount Float?
  razorpayOrderId String?
  razorpayPaymentId String?
  razorpaySignature String?
  pdfUrl String?
  pdfPath String?
  rollNo String?
  createdAt DateTime?
  updatedAt DateTime?

  @@index([studentId])
  @@index([allocationId])
}

model ReportCard {
  id String @id @default(uuid())
  schoolName String?
  examName String?
  className String?
  section String?
  recipientId String?
  recipientName String?
  recipientEmail String?
  rollNumber String?
  arRollNo String?
  templateType String?
  subjects Json?
  total Float?
  percentage Float?
  filePath String?
  mime String?
  createdBy String?
  createdAt DateTime?
  updatedAt DateTime?
}

model Resource {
  id String @id @default(uuid())
  title String
  subject String?
  class String?
  filename String
  originalname String?
  uploadedBy String?
  createdAt DateTime?
  updatedAt DateTime?
}

model SalaryPayment {
  id String @id @default(uuid())
  facultyId String
  facultyName String?
  facultyEmail String?
  month String
  amount Float
  status String?
  receiptNo String?
  razorpayOrderId String?
  razorpayPaymentId String?
  razorpaySignature String?
  createdAt DateTime?
  updatedAt DateTime?
}

model StaffAttendance {
  id String @id @default(uuid())
  date String
  records Json?
  createdBy String?
  createdAt DateTime?
  updatedAt DateTime?
}

model StaffSalaryPayment {
  id String @id @default(uuid())
  userId String
  staffName String?
  staffEmail String?
  month String
  basic Float?
  allowances Float?
  deductions Float?
  amount Float
  status String?
  paymentMethod String?
  paymentDate DateTime?
  notes String?
  receiptNo String?
  razorpayOrderId String?
  razorpayPaymentId String?
  razorpaySignature String?
  createdAt DateTime?
  updatedAt DateTime?
}

model Student {
  id String @id @default(uuid())
  name String
  email String? @unique
  class String?
  section String?
  rollNo String?
  stream String?
  avatar String?
  blocked Boolean?
  gender String?
  medium String?
  category String?
  religion String?
  house String?
  houseRole String?
  parentAccessCode String?
  assignedFees Json?
  createdAt DateTime?
  updatedAt DateTime?

  @@index([class, section])
  @@index([stream])
  @@index([gender])
  @@index([category])
  @@index([religion])
}

model StudentRegistration {
  id String @id @default(uuid())
  name String
  email String @unique
  class String?
  medium String?
  address String?
  school String?
  accessId String?
  avatar String?
  status String?
  note String?
  createdAt DateTime?
  updatedAt DateTime?
}

model Submission {
  id String @id @default(uuid())
  assignmentId String
  studentId String?
  studentName String?
  studentRoll String?
  studentClass String?
  studentEmail String?
  answerText String?
  filePath String?
  submittedAt DateTime?
  createdAt DateTime?
  updatedAt DateTime?

  @@index([assignmentId])
  @@index([studentId])
}

model Syllabus {
  id String @id @default(uuid())
  class String
  section String?
  subject String?
  name String?
  mime String?
  filePath String?
  content String?
  uploadedBy String?
  uploadedAt DateTime?
  createdAt DateTime?
  updatedAt DateTime?
}

model TestResult {
  id String @id @default(uuid())
  test String
  studentId String?
  name String?
  email String?
  rollNo String?
  class String?
  section String?
  score Float?
  total Float?
  percentage Float?
  submittedAt DateTime?
  raw Json?
  createdAt DateTime?
  updatedAt DateTime?

  @@index([test])
  @@index([studentId])
}

model TestSeries {
  id String @id @default(uuid())
  title String
  subject String?
  term String?
  type String?
  link String?
  filePath String?
  classes Json?
  sections Json?
  start DateTime?
  durationMinutes Float?
  attempts Float?
  description String?
  createdBy String?
  createdAt DateTime?
  updatedAt DateTime?
}

model Timetable {
  id String @id @default(uuid())
  class String
  section String?
  name String?
  mime String?
  filePath String?
  content String?
  uploadedBy String?
  uploadedAt DateTime?
  createdAt DateTime?
  updatedAt DateTime?
}

model TransportAllocation {
  id String @id @default(uuid())
  when Float
  routeId String
  stopId String
  busId String
  routeName String?
  stopName String?
  busName String?
  seatNo Float
  paid Boolean?
  payments Json?
  createdAt DateTime?
  updatedAt DateTime?
}

model TransportReceipt {
  id String @id @default(uuid())
  studentId String?
  allocationId String?
  studentName String?
  studentEmail String?
  class String?
  routeId String?
  stopId String?
  busId String?
  routeName String?
  stopName String?
  busName String?
  seatNo Float?
  amount Float?
  razorpayOrderId String?
  razorpayPaymentId String?
  razorpaySignature String?
  pdfUrl String?
  pdfPath String?
  rollNo String?
  createdAt DateTime?
  updatedAt DateTime?
}

model User {
  id String @id @default(uuid())
  username String @unique
  password String
  role String
  name String?
  fatherName String?
  disabled Boolean?
  hr Boolean?
  contact String?
  address String?
  gender String?
  age Float?
  religion String?
  category String?
  designation String?
  avatar String?
  parentOf Json?
  createdAt DateTime?
  updatedAt DateTime?
}
